# Repo-level environment variables for development
# API base URL used by frontend builds (replace with your dev server address)
API_BASE_URL=http://127.0.0.1:8000/api

# Convenience: if using Docker for local backend, update to the container host
#API_BASE_URL=http://10.0.2.2:8000/api  # Android emulator mapping

# Note: DO NOT add secrets (DB passwords, secret keys) here for public repos.
