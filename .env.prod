# Production environment variables (DO NOT commit secrets in a public repository)
# Replace every "replace-with-*" placeholder below with a real value before
# running docker.prod.sh — settings.py now refuses to start if DEBUG or the
# default SECRET_KEY are left on with DJANGO_ENV=production.

DJANGO_ENV=production
DJANGO_DEBUG=False
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-strong-secret
DJANGO_ALLOWED_HOSTS=your-production-domain.example.com
POSTGRES_DB=prod_gym_db
POSTGRES_USER=prod_gym_user
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_PORT=5432

# Public API base URL used by the frontend when deployed
API_BASE_URL=https://your-production-domain.example.com/api

# --- TLS reverse proxy (Caddy, docker-compose.proxy.prod.yml) -----------
# The domain must already point (A/AAAA record) at this server before
# startup — Caddy requests a Let's Encrypt cert for it automatically on
# first boot using ports 80+443. PROXY_EMAIL is only used for renewal
# notices from Let's Encrypt.
PROXY_DOMAIN=replace-with-your-production-domain.example.com
PROXY_EMAIL=replace-with-you@example.com

# --- Stripe (Upgrade / waitlist flow — see you_page.dart) ---------------
# Create a Payment Link in the Stripe Dashboard (Payment Links > New) for
# your Premium price. Paste the resulting https://buy.stripe.com/... URL
# here — no backend integration needed for the pre-order/waitlist version.
STRIPE_PAYMENT_LINK_URL=replace-with-your-stripe-payment-link
# Optional, only needed once you build real webhook-driven billing (P2):
# STRIPE_SECRET_KEY=sk_live_replace-me
# STRIPE_WEBHOOK_SECRET=whsec_replace-me

# --- AI chat / Kaori --------------------------------------------------
# Server-side only — never exposed to Flutter. AI_PROVIDER selects which
# backend AISendMessageStreamView talks to — 'openrouter' or 'freellmapi'
# (see gym_api/views.py:get_ai_service()).
AI_PROVIDER=openrouter

# OpenRouter. Get a key at https://openrouter.ai/keys. Keep the model on
# the free tier unless you deliberately change it (see
# gym_api/ai/openrouter.py) — do not silently fall back to a paid model.
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# freellmapi (github.com/tashfeenahmed/freellmapi). Only used when
# AI_PROVIDER=freellmapi. The container-name URL below works only if
# freellmapi's own compose runs on this same host — ./docker.prod.sh joins
# the backend container to its Docker network (default name:
# freellmapi_default; set FREELLMAPI_DOCKER_NETWORK if yours differs) as a
# best-effort step after startup. If freellmapi runs elsewhere, point
# FREELLMAPI_BASE_URL at its real reachable address instead.
FREELLMAPI_API_KEY=replace-with-your-freellmapi-api-key
FREELLMAPI_BASE_URL=http://freellmapi:3001/v1
FREELLMAPI_MODEL=auto

# Optional production tuning
# GUNICORN_WORKERS=3

