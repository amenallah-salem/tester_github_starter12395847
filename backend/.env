# Local development environment variables for backend
# Loaded by python-dotenv in settings.py
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# API base URL for frontend use (convenience). Use http(s)://host:port/api
API_BASE_URL=http://127.0.0.1:8000/api

# Do NOT commit secrets like DB passwords into this file. Set them in your CI or local env.
