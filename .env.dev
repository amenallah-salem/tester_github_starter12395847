# Local development environment variables (committed as safe defaults)
# Overridable by your local shell environment. Keep secrets out of committed files if possible.

# Backend / Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-secret-key-change-me
POSTGRES_DB=gym_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
#
# API used by frontend during local dev (frontend will use this when built locally)
API_BASE_URL=http://127.0.0.1:8000/api

# Optional: any other development-only flags

# Hosts allowed to access Django (include internal compose host 'backend' used by nginx proxy)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# --- Stripe (Upgrade / waitlist flow — see you_page.dart) ---------------
# Use a Stripe TEST-mode Payment Link here (Dashboard toggle "Test mode" ->
# Payment Links > New) so you can click through Upgrade locally without
# charging anyone. Same key name as .env.prod, different link.
STRIPE_PAYMENT_LINK_URL=replace-with-your-stripe-test-payment-link

# --- Social sign-in (Continue with Google / Continue with Apple) -------
# Comma-separated list of Google OAuth client IDs (one per platform: Web,
# Android, iOS) from Google Cloud Console — accepted audiences for verifying
# Google id_tokens. Leave empty to disable Google sign-in verification.
GOOGLE_OAUTH_CLIENT_IDS=
# Apple app bundle id used as the audience when verifying Apple identity
# tokens (native iOS Sign in with Apple only). e.g. com.tes2.gymApp
APPLE_BUNDLE_ID=

# --- Phone sign-in (Continue with phone) --------------------------------
# Twilio credentials for sending real SMS. Leave empty locally and use
# SAFE_DEV_OTP_AUTH_PASS below instead of setting these up.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# DEVELOPMENT / TESTING ONLY — NEVER CONFIGURE THIS IN PRODUCTION.
# When set, phone OTP requests skip real SMS delivery and use the fixed
# development code 123456 instead (see docs/authentication.md). The backend
# refuses to start if this is set while DJANGO_ENV=production.
SAFE_DEV_OTP_AUTH_PASS=my-local-development-secret


OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free